@using Microsoft.AspNetCore.Components.Web
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>OPC UA Bridge</title>
    <base href="/" />
    <link rel="stylesheet" href="css/app.css" />
    @* InteractiveServer is not optional here. AddInteractiveServerRenderMode() on the
       endpoint only makes the mode available; a .NET 8 Blazor Web App renders components
       statically unless they opt in, and a statically rendered page still returns 200
       while every @onclick, @bind and timer-driven refresh silently does nothing. *@
    <HeadOutlet @rendermode="RenderMode.InteractiveServer" />
</head>
<body>
    <Routes @rendermode="RenderMode.InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
