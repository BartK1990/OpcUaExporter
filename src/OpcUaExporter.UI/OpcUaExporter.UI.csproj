<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    The Blazor UI: routable pages, components and their static web assets.
    Built as a Razor class library so it can be hosted by the WPF shell
    (BlazorWebView) and rendered in isolation by a component test project.
    Static assets are served from _content/OpcUaExporter.UI/.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>OpcUaExporter.UI</RootNamespace>
    <AssemblyName>OpcUaExporter.UI</AssemblyName>
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpcUaExporter.Core\OpcUaExporter.Core.csproj" />
  </ItemGroup>

</Project>
