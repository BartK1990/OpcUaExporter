@page "/diagnostics"
@inject DiagnosticsLogService DiagnosticsService
@implements IDisposable

<div class="app-shell">

    <AppSidebar />

    <main class="content">
        <div class="content-header">
            <h2>Diagnostics</h2>
            <span class="badge">@DiagnosticsService.Entries.Count line(s)</span>
            <button class="btn btn-ghost" @onclick="ClearDiagnostics">Clear</button>
        </div>

        <div class="diagnostics-panel" style="max-height:none; height: calc(100vh - 130px);">
            @if (!DiagnosticsService.Entries.Any())
            {
                <div class="diagnostics-empty">No diagnostics yet.</div>
            }
            else
            {
                @foreach (var line in DiagnosticsService.Entries)
                {
                    <div class="diagnostics-line">@line</div>
                }
            }
        </div>
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        DiagnosticsService.Changed += OnDiagnosticsChanged;
    }

    private void OnDiagnosticsChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void ClearDiagnostics() => DiagnosticsService.Clear();

    public void Dispose()
    {
        DiagnosticsService.Changed -= OnDiagnosticsChanged;
    }
}
