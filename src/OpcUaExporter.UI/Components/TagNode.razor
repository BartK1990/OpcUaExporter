@using OpcUaExporter.Models

<div class="tag-node @(Tag.NodeClass == "Object" ? "tag-object" : "tag-variable")">
    <div class="tag-row" @onclick="Toggle"
         @oncontextmenu="@(e => OnContextMenu.InvokeAsync((Tag, e)))" @oncontextmenu:preventDefault>
        @if (Tag.IsLoadingChildren)
        {
            <span class="chevron"><span class="spinner spinner-xs"></span></span>
        }
        else if (IsExpandable)
        {
            <span class="chevron @(IsExpanded && Tag.Children.Any() ? "expanded" : "")"
                  title="@(Tag.CanLoadChildren ? "Expand (loads from server)" : IsExpanded ? "Collapse" : "Expand")"
                  @onclick="ToggleExpanded" @onclick:stopPropagation>▶</span>
        }
        else
        {
            <span class="chevron-spacer"></span>
        }

        @if (Tag.IsSelectable)
        {
            <input type="checkbox" class="tag-check"
                   checked="@Tag.IsSelected"
                   @onclick:stopPropagation
                   @onchange="() => OnToggle.InvokeAsync(Tag)" />
        }

        <span class="tag-icon"><i class="bi @NodeIcon"></i></span>
        <span class="tag-name">@Tag.DisplayName</span>

        @if (IsSubscribed)
        {
            <span class="subscribed-dot" title="Subscribed"></span>
        }

        @if (Tag.Children.Any())
        {
            <span class="folder-actions" @onclick:stopPropagation>
                <button type="button" class="folder-action-btn" @onclick="() => OnSelectAllInFolder.InvokeAsync(Tag)">All</button>
                <button type="button" class="folder-action-btn" @onclick="() => OnSelectNoneInFolder.InvokeAsync(Tag)">None</button>
            </span>
        }

        @if (Tag.NodeClass == "Variable")
        {
            <span class="tag-type">@Tag.DataType</span>
            @if (Tag.Value != null)
            {
                <span class="tag-value">@Tag.Value</span>
            }
        }
    </div>

    @if (IsExpanded && Tag.Children.Any())
    {
        <div class="tag-children">
            @foreach (var child in VisibleChildren)
            {
                <TagNode Tag="child"
                         @key="child.NodeId"
                         OnToggle="OnToggle"
                         OnSelectAllInFolder="OnSelectAllInFolder"
                         OnSelectNoneInFolder="OnSelectNoneInFolder"
                         OnContextMenu="OnContextMenu"
                         OnLoadChildren="OnLoadChildren"
                         SubscribedNodeIds="SubscribedNodeIds"
                         FilterActive="FilterActive" />
            }

            @if (HasMoreChildren)
            {
                <button type="button" class="btn btn-ghost" @onclick="ShowMoreChildren">
                    Load more (@(Tag.Children.Count - _visibleChildrenCount) remaining)
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter] public OpcTag Tag { get; set; } = null!;
    [Parameter] public EventCallback<OpcTag> OnToggle { get; set; }
    [Parameter] public EventCallback<OpcTag> OnSelectAllInFolder { get; set; }
    [Parameter] public EventCallback<OpcTag> OnSelectNoneInFolder { get; set; }
    [Parameter] public EventCallback<(OpcTag Tag, MouseEventArgs Args)> OnContextMenu { get; set; }

    /// <summary>Asks the host to fetch this node's children from the server (it isn't browsed yet).</summary>
    [Parameter] public EventCallback<OpcTag> OnLoadChildren { get; set; }
    [Parameter] public IReadOnlySet<string> SubscribedNodeIds { get; set; } = new HashSet<string>();
    [Parameter] public bool FilterActive { get; set; }

    private bool IsSubscribed => Tag.NodeClass == "Variable" && SubscribedNodeIds.Contains(Tag.NodeId);

    /// <summary>While a search/selection filter is active, every rendered branch is forced open
    /// (the tree is already pruned to matches, so there's nothing to hide behind a collapsed folder).</summary>
    private bool IsExpanded => FilterActive || _expanded;

    /// <summary>Loaded nodes with children, plus nodes not browsed yet (which may have some: expanding asks the server).</summary>
    private bool IsExpandable => Tag.Children.Any() || (Tag.CanLoadChildren && !FilterActive);

    private const int ChildBatchSize = 200;

    private bool _expanded = false;
    private int _visibleChildrenCount = ChildBatchSize;

    private IEnumerable<OpcTag> VisibleChildren => Tag.Children.Take(_visibleChildrenCount);
    private bool HasMoreChildren => Tag.Children.Count > _visibleChildrenCount;

    /// <summary>Row click: selects a Variable, expands/collapses anything else. Variables that have
    /// children (structured types) are expanded via the chevron instead.</summary>
    private Task Toggle()
    {
        if (Tag.IsSelectable)
            return OnToggle.InvokeAsync(Tag);

        return ToggleExpanded();
    }

    private Task ToggleExpanded()
    {
        if (Tag.IsLoadingChildren)
            return Task.CompletedTask;

        // Not browsed yet (the background scan hasn't reached it): fetch just this node's children now.
        if (Tag.CanLoadChildren && !FilterActive)
        {
            _expanded = true;
            return OnLoadChildren.InvokeAsync(Tag);
        }

        if (Tag.Children.Any())
            _expanded = !_expanded;
        return Task.CompletedTask;
    }

    private void ShowMoreChildren()
    {
        _visibleChildrenCount = Math.Min(Tag.Children.Count, _visibleChildrenCount + ChildBatchSize);
    }

    private string NodeIcon => Tag.NodeClass switch
    {
        "Object"   => IsExpanded && Tag.Children.Any() ? "bi-folder2-open" : "bi-folder2",
        "Variable" => "",
        _          => "bi-circle"
    };
}
