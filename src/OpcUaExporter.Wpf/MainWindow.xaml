<Window x:Class="OpcUaExporter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:ui="clr-namespace:OpcUaExporter.UI.Components;assembly=OpcUaExporter.UI"
        Title="OPC UA Exporter"
        Icon="pack://application:,,,/wwwroot/app.ico"
        MinWidth="960" MinHeight="620"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        Background="#0D0F12">

    <Grid>
        <!-- Services are assigned in the code-behind from the DI container
             built in App.OnStartup. -->
        <blazor:BlazorWebView x:Name="BlazorWebView" HostPage="wwwroot/index.html">
            <blazor:BlazorWebView.RootComponents>
                <blazor:RootComponent Selector="#app" ComponentType="{x:Type ui:Routes}" />
            </blazor:BlazorWebView.RootComponents>
        </blazor:BlazorWebView>
    </Grid>
</Window>
