<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Desktop application services: the stateful OpcUaService facade the Blazor
    pages bind to, the saved-profiles library, CSV/JSON/Excel export, theming
    and the host abstractions. The OPC UA protocol work itself lives in
    OpcUaShared.
    Deliberately free of any UI (WPF, Blazor, WebView) dependency so it can be
    referenced from a test project and hosted from any front end.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>OpcUaExporter</RootNamespace>
    <AssemblyName>OpcUaExporter.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.*" />
    <!-- Version matched to what the OPC UA SDK already pulls in, so the
         restore graph has no downgrade to resolve. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.*" />
    <PackageReference Include="Newtonsoft.Json" Version="13.*" />
    <!-- Cross-platform, MIT-licensed .xlsx writer (built on OpenXML SDK) — no Windows/Office dependency. -->
    <PackageReference Include="OfficeIMO.Excel" Version="3.4.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- The OPC UA SDK and the client primitives now live here, shared with
         the headless gateway (OpcUaBridge). -->
    <ProjectReference Include="..\OpcUaShared\OpcUaShared.csproj" />
  </ItemGroup>

</Project>
