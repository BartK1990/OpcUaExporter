<Window x:Class="OpcUaExporter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        Title="OPC UA Exporter"
        Icon="/app.ico"
        MinWidth="960" MinHeight="620"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        Background="#0D0F12">

    <Grid>
        <blazor:BlazorWebView x:Name="BlazorWebView"
                              HostPage="wwwroot/index.html"
                              Services="{x:Static local:App.Services}"
                              xmlns:local="clr-namespace:OpcUaExporter">
            <blazor:BlazorWebView.RootComponents>
                <blazor:RootComponent Selector="#app"
                                      ComponentType="{x:Type components:App}"
                                      xmlns:components="clr-namespace:OpcUaExporter.Components" />
            </blazor:BlazorWebView.RootComponents>
        </blazor:BlazorWebView>
    </Grid>
</Window>
