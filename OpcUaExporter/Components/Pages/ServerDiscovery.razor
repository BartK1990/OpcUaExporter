@page "/discover-servers"
@using OpcUaExporter.Models
@using OpcUaExporter.Services
@inject OpcUaService Opc
@inject NavigationManager Nav
@implements IDisposable

<div class="app-shell">

    <aside class="sidebar">
        <div class="sidebar-header">
            <div class="logo">
                <img class="logo-icon" src="app.ico" />
                <span class="logo-text">OPC UA<br><small>Exporter</small></span>
            </div>
        </div>

        <section class="panel">
            <h3 class="panel-title">Navigation</h3>
            <nav class="nav-menu">
                <NavLink href="/" Match="NavLinkMatch.All" class="btn btn-ghost nav-link">Tag Browser</NavLink>
                <NavLink href="/connection-settings" class="btn btn-ghost nav-link">Connection Settings</NavLink>
                <NavLink href="/discover-servers" class="btn btn-ghost nav-link">Discover Servers</NavLink>
                <NavLink href="/diagnostics" class="btn btn-ghost nav-link">Diagnostics</NavLink>
            </nav>
        </section>

        <div class="status-bar @(Opc.HasError ? "status-error" : "status-ok")">
            @Opc.StatusMessage
        </div>
    </aside>

    <main class="content">
        <section class="browser-panel connection-settings-scroll">
            <div class="content-header">
                <h2>Discover Servers</h2>
                <span class="badge">@Opc.DiscoveredServers.Count found</span>
            </div>

            <section class="panel settings-panel">
                <h3 class="panel-title">Target Host</h3>

                <label class="field-label">IP Address / Hostname</label>
                <input class="field-input" @bind="Opc.DiscoveryHost" placeholder="192.168.1.10" disabled="@Opc.IsBusy" />

                <div class="btn-row" style="margin-top:10px;">
                    <button class="btn btn-secondary" @onclick="QuickScan" disabled="@(Opc.IsBusy || string.IsNullOrWhiteSpace(Opc.DiscoveryHost))">
                        ⚡ Quick Scan (Common Ports)
                    </button>
                    <button class="btn btn-primary" @onclick="FullScan" disabled="@(Opc.IsBusy || string.IsNullOrWhiteSpace(Opc.DiscoveryHost))">
                        🔍 Full Scan (All 65535 Ports)
                    </button>
                </div>

                @if (Opc.IsScanningPorts)
                {
                    <button class="btn btn-ghost" style="margin-top:8px;" @onclick="CancelScan">✕ Cancel Scan</button>

                    <div class="scan-progress-row">
                        <div class="scan-progress-bar">
                            <div class="scan-progress-fill" style="width:@(ProgressPercent.ToString("0.0"))%;"></div>
                        </div>
                        <span class="mono scan-progress-text">@Opc.ScanProgressCount / @Opc.ScanTotalCount ports</span>
                    </div>
                }
            </section>

            @if (Opc.DiscoveredServers.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon">📡</div>
                    <h2>@(Opc.IsScanningPorts ? "Scanning…" : "No Servers Found Yet")</h2>
                    <p>Enter an IP address and start a scan. Common OPC UA ports are checked first, so real servers usually show up within a few seconds.</p>
                </div>
            }
            else
            {
                <div class="table-wrapper" style="margin-top:14px;">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Port</th>
                                <th>Endpoint URL</th>
                                <th>Application Name</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var server in Opc.DiscoveredServers)
                            {
                                <tr>
                                    <td class="mono">@server.Port</td>
                                    <td class="mono">@server.EndpointUrl</td>
                                    <td>@(server.ApplicationName ?? "–")</td>
                                    <td>
                                        <button class="btn btn-ghost icon-btn" @onclick="() => UseEndpoint(server)">Use</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </main>
</div>

@code {
    private double ProgressPercent => Opc.ScanTotalCount == 0 ? 0 : (double)Opc.ScanProgressCount / Opc.ScanTotalCount * 100;

    protected override void OnInitialized()
    {
        Opc.StateChanged += OnServiceStateChanged;
    }

    private async Task QuickScan() => await Opc.QuickScanAsync();
    private async Task FullScan() => await Opc.FullScanAsync();

    private Task CancelScan()
    {
        Opc.CancelScan();
        return Task.CompletedTask;
    }

    private void UseEndpoint(DiscoveredServerInfo server)
    {
        Opc.Profile.EndpointUrl = server.EndpointUrl;
        Nav.NavigateTo("/");
    }

    private void OnServiceStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Opc.StateChanged -= OnServiceStateChanged;
    }
}
