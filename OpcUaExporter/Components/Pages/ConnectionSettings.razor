@page "/connection-settings"
@using OpcUaExporter.Models
@using OpcUaExporter.Services
@inject OpcUaService Opc
@inject IJSRuntime JS
@implements IDisposable

<div class="app-shell">

    <aside class="sidebar">
        <div class="sidebar-header">
            <div class="logo">
                <span class="logo-icon">⬡</span>
                <span class="logo-text">OPC UA<br><small>Exporter</small></span>
            </div>
        </div>

        <section class="panel">
            <h3 class="panel-title">Navigation</h3>
            <nav class="nav-menu">
                <NavLink href="/" Match="NavLinkMatch.All" class="btn btn-ghost nav-link">Tag Browser</NavLink>
                <NavLink href="/connection-settings" class="btn btn-ghost nav-link">Connection Settings</NavLink>
                <NavLink href="/diagnostics" class="btn btn-ghost nav-link">Diagnostics</NavLink>
            </nav>
        </section>

        <div class="status-bar @(Opc.HasError ? "status-error" : "status-ok")">
            @Opc.StatusMessage
        </div>
    </aside>

    <main class="content">
        <section class="browser-panel connection-settings-scroll">
            <div class="content-header">
                <h2>Connection Settings</h2>
                <span class="badge">OPC UA</span>
            </div>

            <div class="settings-grid">
                <section class="panel settings-panel">
                    <h3 class="panel-title">Endpoint</h3>

                    <label class="field-label">Server Name</label>
                    <input class="field-input" @bind="Opc.Profile.Name" />

                    <label class="field-label">Endpoint URL</label>
                    <input class="field-input" @bind="Opc.Profile.EndpointUrl" placeholder="opc.tcp://192.168.1.10:4840" />
                </section>

                <section class="panel settings-panel">
                    <h3 class="panel-title">Security</h3>

                    <label class="field-label">Security Mode</label>
                    <select class="field-input" @bind="Opc.Profile.SecurityMode">
                        @foreach (var mode in Opc.SecurityModeOptions)
                        {
                            <option value="@mode">@mode</option>
                        }
                    </select>

                    <label class="field-label">Security Policy</label>
                    <select class="field-input" @bind="Opc.Profile.SecurityPolicy">
                        @foreach (var policy in Opc.SecurityPolicyOptions)
                        {
                            <option value="@policy">@PolicyDisplay(policy)</option>
                        }
                    </select>
                </section>

                <section class="panel settings-panel">
                    <h3 class="panel-title">Authentication</h3>

                    <label class="field-label">Authentication Type</label>
                    <select class="field-input" @bind="Opc.Profile.AuthenticationType">
                        @foreach (var type in Opc.AuthenticationOptions)
                        {
                            <option value="@type">@type</option>
                        }
                    </select>

                    @if (Opc.Profile.AuthenticationType == AuthenticationType.UsernamePassword)
                    {
                        <label class="field-label">Username</label>
                        <input class="field-input" @bind="Opc.Profile.Username" autocomplete="username" />

                        <label class="field-label">Password</label>
                        <input class="field-input" type="password" @bind="Opc.Profile.Password" autocomplete="current-password" />
                    }
                </section>

                <section class="panel settings-panel">
                    <h3 class="panel-title">Browse Performance</h3>

                    <label class="field-label">Parallel top-level browse</label>
                    <input type="checkbox" @bind="Opc.Profile.EnableParallelBrowse" />

                    @if (Opc.Profile.EnableParallelBrowse)
                    {
                        <label class="field-label">Max parallel branches</label>
                        <input class="field-input"
                               type="number"
                               min="1"
                               max="32"
                               @bind="Opc.Profile.ParallelBrowseMaxDegree" />
                    }
                </section>
            </div>

            @if (_warnings.Count > 0)
            {
                <section class="panel settings-panel" style="margin-top: 12px;">
                    <h3 class="panel-title">Validation Warnings</h3>
                    @foreach (var warning in _warnings)
                    {
                        <div class="status-bar status-error" style="margin-top:6px; padding:8px 10px; border:1px solid var(--border); border-radius: var(--radius);">
                            @warning
                        </div>
                    }
                </section>
            }

            <section class="panel settings-panel" style="margin-top: 12px;">
                <h3 class="panel-title">Connection Check</h3>
                <div class="btn-row">
                    <button class="btn btn-ghost" @onclick="SaveServerProfile" disabled="@Opc.IsBusy">
                        <span>Save Profile</span>
                    </button>

                    <button class="btn btn-secondary" @onclick="DiscoverCapabilities" disabled="@(Opc.IsBusy || string.IsNullOrWhiteSpace(Opc.Profile.EndpointUrl))">
                        @if (Opc.IsBusy)
                        {
                            <span class="spinner"></span><span>Working…</span>
                        }
                        else
                        {
                            <span>Discover Modes</span>
                        }
                    </button>

                    <button class="btn btn-primary" @onclick="TestConnection" disabled="@(Opc.IsBusy || _warnings.Count > 0)">
                        @if (Opc.IsBusy)
                        {
                            <span class="spinner"></span><span>Testing…</span>
                        }
                        else
                        {
                            <span>Test Connection</span>
                        }
                    </button>
                </div>
            </section>

            @if (_capabilities is not null)
            {
                <section class="panel settings-panel" style="margin-top: 12px;">
                    <h3 class="panel-title">Discovered Server</h3>
                    <div class="selection-count">@_capabilities.ServerName</div>

                    @if (_capabilities.SecurityOptions.Count == 0)
                    {
                        <div class="status-bar" style="margin-top:6px; padding:8px 10px; border:1px solid var(--border); border-radius: var(--radius);">
                            No security combinations were returned.
                        </div>
                    }
                    else
                    {
                        @foreach (var option in _capabilities.SecurityOptions)
                        {
                            <div class="status-bar" style="margin-top:6px; padding:8px 10px; border:1px solid var(--border); border-radius: var(--radius);">
                                <div><strong>Mode:</strong> @option.SecurityMode</div>
                                <div><strong>Policy:</strong> @PolicyDisplay(option.SecurityPolicy)</div>
                                <div><strong>Auth:</strong> @AuthDisplay(option)</div>
                                <div class="btn-row" style="margin-top:8px;">
                                    <button class="btn btn-ghost" @onclick="() => ApplyDiscoveredOption(option)">
                                        Apply to selections
                                    </button>
                                </div>
                            </div>
                        }
                    }
                </section>
            }
        </section>
    </main>
</div>

@code {
    private List<string> _warnings = new();
    private ServerCapabilitiesInfo? _capabilities;

    protected override void OnInitialized()
    {
        Opc.StateChanged += OnServiceStateChanged;
        RefreshWarnings();
    }

    private async Task TestConnection()
    {
        RefreshWarnings();
        if (_warnings.Count > 0)
            return;

        await Opc.TestConnectionAsync();
        RefreshWarnings();
    }

    private async Task DiscoverCapabilities()
    {
        _capabilities = await Opc.DiscoverServerCapabilitiesAsync();
        if (_capabilities is not null)
            StateHasChanged();
    }

    private async Task SaveServerProfile()
    {
        try
        {
            var path = await JS.InvokeAsync<string>("showSaveDialog", "Server Profile (*.json)|*.json|All Files (*.*)|*.*");
            if (string.IsNullOrWhiteSpace(path))
                return;

            await Opc.SaveProfileAsync(path);
        }
        catch
        {
            // JS interop not available in some preview modes – ignore
        }
    }

    private void OnServiceStateChanged()
    {
        RefreshWarnings();
        _ = InvokeAsync(StateHasChanged);
    }

    private void RefreshWarnings()
    {
        _warnings = Opc.GetConnectionValidationWarnings();
    }

    private void ApplyDiscoveredOption(ServerSecurityOption option)
    {
        Opc.Profile.SecurityMode = option.SecurityMode;
        Opc.Profile.SecurityPolicy = option.SecurityPolicy;

        if (option.SupportsAnonymous)
        {
            Opc.Profile.AuthenticationType = AuthenticationType.Anonymous;
        }
        else if (option.SupportsUsernamePassword)
        {
            Opc.Profile.AuthenticationType = AuthenticationType.UsernamePassword;
        }

        RefreshWarnings();
        StateHasChanged();
    }

    private static string PolicyDisplay(string policy)
        => policy switch
        {
            "http://opcfoundation.org/UA/SecurityPolicy#None" => "None",
            "http://opcfoundation.org/UA/SecurityPolicy#Basic128Rsa15" => "Basic128Rsa15",
            "http://opcfoundation.org/UA/SecurityPolicy#Basic256" => "Basic256",
            "http://opcfoundation.org/UA/SecurityPolicy#Basic256Sha256" => "Basic256Sha256",
            "http://opcfoundation.org/UA/SecurityPolicy#Aes128_Sha256_RsaOaep" => "Aes128_Sha256_RsaOaep",
            "http://opcfoundation.org/UA/SecurityPolicy#Aes256_Sha256_RsaPss" => "Aes256_Sha256_RsaPss",
            _ => policy
        };

    private static string AuthDisplay(ServerSecurityOption option)
    {
        var auth = new List<string>();
        if (option.SupportsAnonymous)
            auth.Add("Anonymous");
        if (option.SupportsUsernamePassword)
            auth.Add("UsernamePassword");
        return auth.Count == 0 ? "None" : string.Join(", ", auth);
    }

    public void Dispose()
    {
        Opc.StateChanged -= OnServiceStateChanged;
    }
}
