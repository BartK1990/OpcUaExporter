@page "/"
@using OpcUaExporter.Models
@using OpcUaExporter.Services
@inject OpcUaService Opc
@inject IJSRuntime JS
@inject DiagnosticsLogService Diagnostics
@inject ThemeService ThemeSvc
@implements IDisposable

<div class="app-shell">

    <!-- ═══════════════════════ SIDEBAR ═══════════════════════ -->
    <AppSidebar>
        @if (Opc.PendingCertificates.Any())
        {
            <section class="panel">
                <h3 class="panel-title">Server Certificates</h3>
                <p class="selection-count">Untrusted certificates detected. Review and trust as needed.</p>

                @foreach (var cert in Opc.PendingCertificates)
                {
                    <div class="status-bar status-error" style="margin-bottom:8px;">
                        <div><strong>@cert.Subject</strong></div>
                        <div class="mono" style="font-size:12px;">Issuer: @cert.Issuer</div>
                        <div class="mono" style="font-size:12px;">Thumbprint: @cert.Thumbprint</div>
                        <div style="font-size:12px;">Valid: @cert.ValidFrom.ToLocalTime():yyyy-MM-dd - @cert.ValidTo.ToLocalTime():yyyy-MM-dd</div>
                        <div class="btn-row" style="margin-top:8px;">
                            <button class="btn btn-secondary" @onclick="() => TrustCertificate(cert.Thumbprint)" disabled="@Opc.IsBusy">Trust</button>
                            <button class="btn btn-ghost" @onclick="() => RejectCertificate(cert.Thumbprint)" disabled="@Opc.IsBusy">Reject</button>
                        </div>
                    </div>
                }
            </section>
        }

        <!-- Connection profile -->
        <section class="panel">
            <h3 class="panel-title">Server Connection</h3>

            <label class="field-label">Server Name</label>
            <input class="field-input" @bind="Opc.Profile.Name" placeholder="My PLC" />

            <label class="field-label">Endpoint URL</label>
            <input class="field-input" @bind="Opc.Profile.EndpointUrl"
                   placeholder="opc.tcp://192.168.1.10:4840" />

            <button class="btn btn-primary" @onclick="Browse" disabled="@Opc.IsBusy">
                @if (Opc.IsBusy)
                {
                    <span class="spinner"></span><span>Working…</span>
                }
                else
                {
                    <span>⟳ Browse Tags</span>
                }
            </button>

            @if (Opc.IsBrowsing)
            {
                <button class="btn btn-ghost" @onclick="CancelBrowse">
                    ✕ Cancel Browse
                </button>
            }

            <div class="btn-row">
                <button class="btn btn-ghost" @onclick="SaveServerProfile" disabled="@Opc.IsBusy">Save Profile</button>
                <button class="btn btn-ghost" @onclick="LoadServerProfile" disabled="@Opc.IsBusy">Load Profile</button>
            </div>
        </section>

        <!-- Selection actions -->
        @if (Opc.TagTree.Any())
        {
            <section class="panel">
                <h3 class="panel-title">Selection</h3>
                <div class="btn-row">
                    <button class="btn btn-ghost" @onclick="() => Opc.SelectAll(true)">All</button>
                    <button class="btn btn-ghost" @onclick="() => Opc.SelectAll(false)">None</button>
                </div>
                <p class="selection-count">@SelectedCount tag(s) selected</p>
            </section>

            <!-- Export -->
            <section class="panel">
                <h3 class="panel-title">Export</h3>

                <label class="field-label">Format</label>
                <select class="field-input" @bind="_exportFormat">
                    <option value="Csv">CSV (.csv)</option>
                    <option value="Json">JSON (.json)</option>
                </select>

                <label class="field-label">Output Path</label>
                <div class="path-row">
                    <input class="field-input" @bind="_exportPath" placeholder="C:\export\tags.csv" />
                    <button class="btn btn-ghost icon-btn" @onclick="BrowseOutputPath" title="Browse…">📂</button>
                </div>

                <button class="btn btn-accent" @onclick="Export" disabled="@(Opc.IsBusy || SelectedCount == 0)">
                    ↓ Export Selected
                </button>
            </section>
        }

        <!-- Status bar -->
        <div class="status-bar @(Opc.HasError ? "status-error" : "status-ok")">
            @Opc.StatusMessage
        </div>
    </AppSidebar>

    <!-- ═══════════════════════ MAIN CONTENT ═══════════════════════ -->
    <main class="content">

        @if (!Opc.TagTree.Any() && !Opc.IsBusy)
        {
            <div class="empty-state">
                <h2>No Tags Loaded</h2>
                <p>Enter your OPC UA server endpoint and click <strong>Browse Tags</strong>.</p>
            </div>
        }
        else
        {
            <div class="content-header">
                <h2>Tag Browser</h2>
                <span class="badge">@Opc.BrowsedVariableCount variable tags</span>
            </div>

            <div class="browse-layout">

                <!-- Tag tree (left pane) -->
                <section class="browser-panel">
                    <div class="tag-search-row">
                        <input class="field-input tag-search-input" placeholder="🔍 Search by name or node ID…"
                               @bind="_tagFilter" @bind:event="oninput" />
                        @if (!string.IsNullOrEmpty(_tagFilter))
                        {
                            <button class="btn btn-ghost icon-btn" title="Clear search" @onclick="ClearTagFilter">✕</button>
                        }
                        <label class="tag-filter-toggle">
                            <input type="checkbox" @bind="_selectedOnly" />
                            Selected only
                        </label>
                        @if (IsTagFilterActive)
                        {
                            <span class="badge">@FilterMatchCount match(es)</span>
                        }
                    </div>
                    <div class="tag-tree-container tag-tree-scroll">
                        @if (IsTagFilterActive && FilteredTagTree.Count == 0)
                        {
                            <div class="empty-state">
                                <div class="empty-icon">🔍</div>
                                <p>No tags match your filter.</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var tag in FilteredTagTree)
                            {
                                <TagNode Tag="tag"
                                         @key="tag.NodeId"
                                         OnToggle="HandleToggle"
                                         OnSelectAllInFolder="HandleSelectAllInFolder"
                                         OnSelectNoneInFolder="HandleSelectNoneInFolder"
                                         OnContextMenu="HandleContextMenu"
                                         SubscribedNodeIds="Opc.SubscribedNodeIds"
                                         FilterActive="IsTagFilterActive" />
                            }
                        }
                    </div>
                </section>

                <div class="pane-divider" title="Drag to resize"></div>

                <!-- Chosen tags (right pane) -->
                <section class="selected-panel">
                    <div class="content-header">
                        <h2>Selected Tags</h2>
                        <span class="badge">@SelectedCount tag(s)</span>
                        <button class="btn btn-ghost compact-toggle @(ThemeSvc.CompactSelectedRows ? "active" : "")"
                                title="@(ThemeSvc.CompactSelectedRows ? "Switch to normal row height" : "Switch to compact row height")"
                                @onclick="() => ThemeSvc.SetCompactSelectedRows(!ThemeSvc.CompactSelectedRows)">
                            ☰ Compact
                        </button>
                    </div>

                    <div class="btn-row selected-actions">
                        <button class="btn btn-secondary" @onclick="ReadSelected" disabled="@(Opc.IsBusy || SelectedCount == 0)">
                            ▶ Read Values
                        </button>

                        <button class="btn btn-secondary" @onclick="SubscribeSelected" disabled="@(Opc.IsBusy || SelectedCount == 0)">
                            🔔 Subscribe
                        </button>

                        <button class="btn btn-secondary" @onclick="TrendSelected" disabled="@(Opc.IsBusy || SelectedCount == 0)">
                            📈 Trend All
                        </button>

                        <button class="btn btn-ghost" @onclick="() => Opc.SelectAll(false)" disabled="@(Opc.IsBusy || SelectedCount == 0)">
                            ✕ Clear All
                        </button>
                    </div>

                    <div class="btn-row selected-actions">
                        @if (!Opc.IsRecording)
                        {
                            <button class="btn btn-secondary" @onclick="StartRecording" disabled="@(Opc.IsBusy || SelectedCount == 0)">
                                ⏺ Record to CSV
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-ghost" @onclick="StopRecording" disabled="@Opc.IsBusy">
                                ⏹ Stop Recording
                            </button>
                        }
                    </div>

                    @if (Opc.IsRecording)
                    {
                        <div class="recording-indicator">
                            <span class="recording-dot"></span>
                            <span>Recording (@Opc.RecordedRowCount rows) → @Opc.RecordingFilePath</span>
                        </div>
                    }

                    <button class="btn btn-ghost" @onclick="StopSubscription" disabled="@(Opc.IsBusy || !Opc.IsSubscribed)">
                        ⏹ Stop Subscription
                    </button>

                    @if (SelectedCount == 0)
                    {
                        <div class="empty-state">
                            <div class="empty-icon">☐</div>
                            <p>Check tags on the left to add them here.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-wrapper selected-table-wrapper @(ThemeSvc.CompactSelectedRows ? "compact" : "")">
                            <table class="data-table resizable-table">
                                <colgroup>
                                    <col style="width:36px;" />
                                    <col style="width:26px;" />
                                    <col style="width:36px;" />
                                    <col style="width:160px;" />
                                    <col style="width:220px;" />
                                    <col style="width:110px;" />
                                    <col style="width:110px;" />
                                    <col style="width:90px;" />
                                    <col style="width:170px;" />
                                    <col style="width:150px;" />
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th class="col-fixed-icon"></th>
                                        <th class="col-fixed-icon"></th>
                                        <th class="col-fixed-icon" title="Add to trend">📈</th>
                                        <th class="resizable-th">
                                            <span class="th-label sortable" @onclick="ToggleSelectedSort" title="Sort by name">Display Name @SelectedSortIndicator</span>
                                            <span class="col-resize-handle"></span>
                                        </th>
                                        <th class="resizable-th"><span class="th-label">Node ID</span><span class="col-resize-handle"></span></th>
                                        <th class="resizable-th"><span class="th-label">Value</span><span class="col-resize-handle"></span></th>
                                        <th class="resizable-th"><span class="th-label">Data Type</span><span class="col-resize-handle"></span></th>
                                        <th class="resizable-th"><span class="th-label">Quality</span><span class="col-resize-handle"></span></th>
                                        <th class="resizable-th"><span class="th-label">Timestamp</span><span class="col-resize-handle"></span></th>
                                        <th class="resizable-th"><span class="th-label">Write</span><span class="col-resize-handle"></span></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var tag in SelectedTags)
                                    {
                                        var reading = FindReading(tag.NodeId);
                                        var subscribed = Opc.SubscribedNodeIds.Contains(tag.NodeId);
                                        <tr class="@(reading?.Error != null ? "row-error" : "")">
                                            <td class="col-fixed-icon">
                                                <button class="btn btn-ghost icon-btn" title="Remove from selection" @onclick="() => Opc.ToggleTag(tag)">✕</button>
                                            </td>
                                            <td class="col-fixed-icon">
                                                @if (subscribed)
                                                {
                                                    <span class="subscribed-dot" title="Subscribed"></span>
                                                }
                                            </td>
                                            <td class="col-fixed-icon">
                                                @{ var trending = Opc.TrendedNodeIds.Contains(tag.NodeId, StringComparer.OrdinalIgnoreCase); }
                                                <input type="checkbox" class="tag-check" title="@(trending ? "Remove from trend" : "Add to trend")"
                                                       checked="@trending" disabled="@Opc.IsBusy"
                                                       @onchange="() => ToggleTagTrend(tag.NodeId)" />
                                            </td>
                                            <td>@tag.DisplayName</td>
                                            <td class="mono">@tag.NodeId</td>
                                            <td class="mono">@(reading?.Error ?? reading?.Value?.ToString() ?? "–")</td>
                                            <td>@(reading?.DataType ?? tag.DataType)</td>
                                            <td class="@QualityClass(reading?.Quality)">@reading?.Quality</td>
                                            <td class="mono">@reading?.Timestamp</td>
                                            <td>
                                                <div class="inline-write">
                                                    <input class="mono write-input" placeholder="value"
                                                           value="@GetWriteInput(tag.NodeId)"
                                                           @onchange="e => _writeInputByNodeId[tag.NodeId] = e.Value?.ToString() ?? string.Empty" />
                                                    <button class="btn btn-ghost icon-btn" title="Write value"
                                                            disabled="@(Opc.IsBusy || string.IsNullOrWhiteSpace(GetWriteInput(tag.NodeId)))"
                                                            @onclick="() => WriteInlineValue(tag.NodeId)">✎</button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>

            </div>

            @if (Opc.IsChartVisible)
            {
                <div class="row-divider" title="Drag to resize"></div>
                <section class="chart-panel">
                    <div class="content-header chart-panel-header">
                        <h2>Live Trend</h2>
                        <span class="badge">@Opc.TrendedNodeIds.Count series</span>
                        <label class="trend-window-control">
                            Window
                            <input type="number" class="trend-window-input" min="5" max="3600" step="5"
                                   value="@_trendWindowSeconds" @onchange="OnTrendWindowChanged" />
                            s
                        </label>
                        <button class="btn btn-ghost" @onclick="ClearChart">✕ Clear Chart</button>
                    </div>
                    <div class="chart-body">
                        <div class="chart-canvas-wrap">
                            <canvas @ref="_chartCanvasRef" class="chart-canvas"></canvas>
                        </div>
                        <div class="chart-legend-panel @(_legendCollapsed ? "collapsed" : "")">
                            <button type="button" class="legend-collapse-toggle"
                                    title="@(_legendCollapsed ? "Show tag list" : "Hide tag list")"
                                    @onclick="() => _legendCollapsed = !_legendCollapsed">
                                @(_legendCollapsed ? "☰" : "›")
                            </button>
                            @if (!_legendCollapsed)
                            {
                                <div class="chart-legend-list">
                                    @{ var trendIndex = 0; }
                                    @foreach (var t in Opc.GetTrendedTagInfos())
                                    {
                                        var color = Palette[trendIndex++ % Palette.Length];
                                        var isNonNumeric = _nonNumericTrendTags.Contains(t.NodeId);
                                        <div class="legend-row">
                                            <span class="legend-dot" style="background:@color;"></span>
                                            <span class="legend-name" title="@t.NodeId">@t.DisplayName</span>
                                            @if (isNonNumeric)
                                            {
                                                <span class="legend-note" title="This tag's value isn't numeric, so it can't be plotted.">n/a</span>
                                            }
                                            <button type="button" class="axis-toggle"
                                                    title="Plot on the @(t.Axis == "right" ? "left" : "right") axis"
                                                    @onclick="() => ToggleTrendAxis(t.NodeId)">
                                                @(t.Axis == "right" ? "R" : "L")
                                            </button>
                                            <button type="button" class="legend-remove" title="Remove from chart" @onclick="() => RemoveFromChart(t.NodeId)">✕</button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </section>
            }
        }

    </main>
</div>

@if (_contextMenuOpen && _contextMenuTag is not null)
{
    <div class="context-menu-backdrop" @onclick="CloseContextMenu"
         @oncontextmenu="CloseContextMenu" @oncontextmenu:preventDefault></div>
    <div class="context-menu" style="left:@(_contextMenuX)px; top:@(_contextMenuY)px;">
        @if (_contextMenuTag.IsSelectable)
        {
            <button type="button" class="context-menu-item" @onclick="ShowWriteDialog">✏️ Write value…</button>
        }
        <button type="button" class="context-menu-item" @onclick="ShowNodeProperties">🔍 Properties…</button>
    </div>
}

@if (_nodeDetailsOpen)
{
    <div class="modal-overlay" @onclick="CloseNodeDetails">
        <div class="modal" @onclick:stopPropagation>
            <div class="modal-header">
                <h3>Node Properties@(_nodeDetails is not null ? $" — {_nodeDetails.DisplayName}" : "")</h3>
                <button type="button" class="btn btn-ghost icon-btn" @onclick="CloseNodeDetails">✕</button>
            </div>
            <div class="modal-body">
                @if (_nodeDetailsLoading)
                {
                    <div class="btn-row"><span class="spinner"></span><span>Loading…</span></div>
                }
                else if (_nodeDetails is null)
                {
                    <p>Could not load node properties.</p>
                }
                else
                {
                    <h4 class="panel-title">Attributes</h4>
                    <div class="table-wrapper">
                        <table class="data-table">
                            <tbody>
                                @foreach (var attr in _nodeDetails.Attributes)
                                {
                                    <tr>
                                        <td>@attr.Name</td>
                                        <td class="mono">@attr.Value</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <h4 class="panel-title" style="margin-top:16px;">References (@_nodeDetails.References.Count)</h4>
                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Reference Type</th>
                                    <th>Direction</th>
                                    <th>Target</th>
                                    <th>Node Class</th>
                                    <th>Node Id</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in _nodeDetails.References)
                                {
                                    <tr>
                                        <td>@r.ReferenceTypeName</td>
                                        <td>@(r.IsForward ? "→ forward" : "← inverse")</td>
                                        <td>@r.TargetDisplayName</td>
                                        <td>@r.TargetNodeClass</td>
                                        <td class="mono">@r.TargetNodeId</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
}

@if (_writeDialogOpen)
{
    <div class="modal-overlay" @onclick="CloseWriteDialog">
        <div class="modal write-modal" @onclick:stopPropagation>
            <div class="modal-header">
                <h3>Write Value@(_writeDialogDisplayName is not null ? $" — {_writeDialogDisplayName}" : "")</h3>
                <button type="button" class="btn btn-ghost icon-btn" @onclick="CloseWriteDialog">✕</button>
            </div>
            <div class="modal-body">
                <p class="mono write-dialog-nodeid">@_writeDialogNodeId</p>

                <div class="field-label">Data Type</div>
                <p class="mono">@(_writeDialogDataType ?? "unknown")</p>

                <div class="field-label">Value</div>
                <input class="field-input" @bind="_writeDialogValue" @bind:event="oninput"
                       @onkeydown="OnWriteDialogKeyDown" disabled="@Opc.IsBusy" />

                @if (_writeDialogError is not null)
                {
                    <p class="status-error" style="margin-top:8px;">@_writeDialogError</p>
                }

                <div class="btn-row" style="margin-top:16px;">
                    <button class="btn btn-secondary" @onclick="SubmitWriteDialog"
                            disabled="@(Opc.IsBusy || string.IsNullOrWhiteSpace(_writeDialogValue))">
                        ✎ Write
                    </button>
                    <button class="btn btn-ghost" @onclick="CloseWriteDialog">Cancel</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private static bool _startupProfilePromptShown;

    private static readonly string[] Palette =
        ["#f0a030", "#60a8f0", "#3ecf8e", "#f06060", "#c060f0", "#f0e060", "#60f0d0", "#f08060"];

    private string _exportFormat = "Csv";
    private string _exportPath   = string.Empty;

    private ElementReference _chartCanvasRef;
    private bool _chartJsInitialized;
    private bool _chartDirty;
    private bool _legendCollapsed;
    private int _trendWindowSeconds = 60;

    private string _tagFilter = string.Empty;
    private bool _selectedOnly;

    private int SelectedCount  => Opc.GetSelectedNodeIds().Count;
    private int FlatTagCount   => Opc.BrowsedVariableCount;
    private List<OpcTag> SelectedTags
    {
        get
        {
            var tags = Opc.GetSelectedTags().AsEnumerable();
            tags = _selectedSort switch
            {
                SortDirection.Ascending  => tags.OrderBy(t => t.DisplayName, StringComparer.OrdinalIgnoreCase),
                SortDirection.Descending => tags.OrderByDescending(t => t.DisplayName, StringComparer.OrdinalIgnoreCase),
                _ => tags
            };
            return tags.ToList();
        }
    }

    private enum SortDirection { None, Ascending, Descending }
    private SortDirection _selectedSort = SortDirection.None;

    private string SelectedSortIndicator => _selectedSort switch
    {
        SortDirection.Ascending  => "▲",
        SortDirection.Descending => "▼",
        _ => ""
    };

    private void ToggleSelectedSort()
    {
        _selectedSort = _selectedSort switch
        {
            SortDirection.None       => SortDirection.Ascending,
            SortDirection.Ascending  => SortDirection.Descending,
            _                        => SortDirection.None
        };
    }

    private bool IsTagFilterActive => !string.IsNullOrWhiteSpace(_tagFilter) || _selectedOnly;

    private List<OpcTag> FilteredTagTree => IsTagFilterActive
        ? BuildFilteredTree(Opc.TagTree)
        : Opc.TagTree;

    private int FilterMatchCount => IsTagFilterActive ? CountMatches(Opc.TagTree) : 0;

    private void ClearTagFilter() => _tagFilter = string.Empty;

    private bool MatchesTagFilter(OpcTag tag)
    {
        if (!string.IsNullOrWhiteSpace(_tagFilter) &&
            !tag.DisplayName.Contains(_tagFilter, StringComparison.OrdinalIgnoreCase) &&
            !tag.NodeId.Contains(_tagFilter, StringComparison.OrdinalIgnoreCase))
            return false;

        if (_selectedOnly && !(tag.IsSelectable && tag.IsSelected))
            return false;

        return true;
    }

    /// <summary>
    /// Builds a pruned copy of the tag tree containing only nodes that match the
    /// active filter(s) plus their ancestors. Matching leaf/variable nodes reuse the
    /// original OpcTag reference (so checkbox toggling still mutates the real tree);
    /// only non-matching ancestor folders are shallow-cloned to hold a filtered child list.
    /// </summary>
    private List<OpcTag> BuildFilteredTree(List<OpcTag> tags)
    {
        var result = new List<OpcTag>();
        foreach (var tag in tags)
        {
            var filtered = FilterNode(tag);
            if (filtered is not null)
                result.Add(filtered);
        }
        return result;
    }

    private OpcTag? FilterNode(OpcTag tag)
    {
        if (MatchesTagFilter(tag))
            return tag;

        if (tag.Children.Count == 0)
            return null;

        List<OpcTag>? matchedChildren = null;
        foreach (var child in tag.Children)
        {
            var filteredChild = FilterNode(child);
            if (filteredChild is not null)
                (matchedChildren ??= new List<OpcTag>()).Add(filteredChild);
        }

        if (matchedChildren is null)
            return null;

        return new OpcTag
        {
            NodeId      = tag.NodeId,
            BrowseName  = tag.BrowseName,
            DisplayName = tag.DisplayName,
            NodeClass   = tag.NodeClass,
            DataType    = tag.DataType,
            Value       = tag.Value,
            Quality     = tag.Quality,
            IsSelected  = tag.IsSelected,
            Children    = matchedChildren
        };
    }

    private int CountMatches(IEnumerable<OpcTag> tags)
    {
        var count = 0;
        foreach (var t in tags)
        {
            if (MatchesTagFilter(t))
                count++;
            count += CountMatches(t.Children);
        }
        return count;
    }

    private TagReading? FindReading(string nodeId)
        => Opc.LastReadings.FirstOrDefault(r => string.Equals(r.NodeId, nodeId, StringComparison.OrdinalIgnoreCase));

    protected override void OnInitialized()
    {
        Opc.StateChanged += OnServiceStateChanged;
        Opc.TrendUpdate += OnTrendUpdate;
        ThemeSvc.CompactSelectedRowsChanged += OnServiceStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_startupProfilePromptShown)
        {
            _startupProfilePromptShown = true;

            var lastProfilePath = Opc.GetExistingLastProfilePath();
            if (!string.IsNullOrWhiteSpace(lastProfilePath))
            {
                try
                {
                    var shouldLoad = await JS.InvokeAsync<bool>("showConfirm", $"Load last saved server profile?\n{lastProfilePath}");
                    if (shouldLoad)
                    {
                        await Opc.LoadProfileAsync(lastProfilePath);
                        StateHasChanged();
                    }
                }
                catch
                {
                    // JS interop not available in some preview modes – ignore
                }
            }
        }

        if (Opc.IsChartVisible)
        {
            if (!_chartJsInitialized)
            {
                try
                {
                    await JS.InvokeVoidAsync("trendChart.init", _chartCanvasRef);
                    _chartJsInitialized = true;
                    _chartDirty = true;
                    await JS.InvokeVoidAsync("trendChart.setWindow", _trendWindowSeconds * 1000);
                }
                catch (Exception ex)
                {
                    Diagnostics.Add($"Trend chart failed to initialize: {ex.Message}");
                }
            }

            if (_chartDirty)
            {
                _chartDirty = false;
                try
                {
                    var series = Opc.GetTrendedTagInfos()
                        .Select(t => new { nodeId = t.NodeId, label = t.DisplayName, axis = t.Axis })
                        .ToArray();
                    // Cast to object: InvokeVoidAsync takes `params object?[] args`, and an array of a
                    // reference type is array-covariant with object[] — without this cast, C# treats
                    // `series` itself as the whole args array (spreading each tag as a separate JS
                    // argument) instead of passing it as the single `list` parameter setSeries expects.
                    await JS.InvokeVoidAsync("trendChart.setSeries", (object)series);
                    Diagnostics.Add($"Trend chart: now tracking {series.Length} series ({string.Join(", ", series.Select(s => s.nodeId))}).");
                }
                catch (Exception ex)
                {
                    Diagnostics.Add($"Trend chart failed to update series: {ex.Message}");
                }
            }
        }
        else
        {
            _chartJsInitialized = false;
        }
    }

