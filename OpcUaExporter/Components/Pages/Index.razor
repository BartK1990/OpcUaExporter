@page "/"
@using OpcUaExporter.Models
@using OpcUaExporter.Services
@inject OpcUaService Opc
@inject IJSRuntime JS
@implements IDisposable

<div class="app-shell">

    <!-- ═══════════════════════ SIDEBAR ═══════════════════════ -->
    <aside class="sidebar">
        <div class="sidebar-header">
            <div class="logo">
                <span class="logo-icon">⬡</span>
                <span class="logo-text">OPC UA<br><small>Exporter</small></span>
            </div>
        </div>

        <!-- Connection profile -->
        <section class="panel">
            <h3 class="panel-title">Server Connection</h3>

            <label class="field-label">Server Name</label>
            <input class="field-input" @bind="Opc.Profile.Name" placeholder="My PLC" />

            <label class="field-label">Endpoint URL</label>
            <input class="field-input" @bind="Opc.Profile.EndpointUrl"
                   placeholder="opc.tcp://192.168.1.10:4840" />

            <button class="btn btn-primary" @onclick="Browse" disabled="@Opc.IsBusy">
                @if (Opc.IsBusy)
                {
                    <span class="spinner"></span><span>Working…</span>
                }
                else
                {
                    <span>⟳ Browse Tags</span>
                }
            </button>
        </section>

        <!-- Selection actions -->
        @if (Opc.TagTree.Any())
        {
            <section class="panel">
                <h3 class="panel-title">Selection</h3>
                <div class="btn-row">
                    <button class="btn btn-ghost" @onclick="() => Opc.SelectAll(true)">All</button>
                    <button class="btn btn-ghost" @onclick="() => Opc.SelectAll(false)">None</button>
                </div>
                <p class="selection-count">@SelectedCount tag(s) selected</p>

                <button class="btn btn-secondary" @onclick="ReadSelected" disabled="@Opc.IsBusy">
                    ▶ Read Values
                </button>
            </section>

            <!-- Export -->
            <section class="panel">
                <h3 class="panel-title">Export</h3>

                <label class="field-label">Format</label>
                <select class="field-input" @bind="_exportFormat">
                    <option value="Csv">CSV (.csv)</option>
                    <option value="Json">JSON (.json)</option>
                </select>

                <label class="field-label">Output Path</label>
                <div class="path-row">
                    <input class="field-input" @bind="_exportPath" placeholder="C:\export\tags.csv" />
                    <button class="btn btn-ghost icon-btn" @onclick="BrowseOutputPath" title="Browse…">📂</button>
                </div>

                <button class="btn btn-accent" @onclick="Export" disabled="@(Opc.IsBusy || SelectedCount == 0)">
                    ↓ Export Selected
                </button>
            </section>
        }

        <!-- Status bar -->
        <div class="status-bar @(Opc.HasError ? "status-error" : "status-ok")">
            @Opc.StatusMessage
        </div>
    </aside>

    <!-- ═══════════════════════ MAIN CONTENT ═══════════════════════ -->
    <main class="content">

        @if (!Opc.TagTree.Any() && !Opc.IsBusy)
        {
            <div class="empty-state">
                <div class="empty-icon">⬡</div>
                <h2>No Tags Loaded</h2>
                <p>Enter your OPC UA server endpoint and click <strong>Browse Tags</strong>.</p>
            </div>
        }
        else
        {
            <div class="content-header">
                <h2>Tag Browser</h2>
                <span class="badge">@FlatTagCount variable tags</span>
            </div>

            <!-- Tag tree -->
            <div class="tag-tree-container">
                @foreach (var tag in Opc.TagTree)
                {
                    <TagNode Tag="tag" OnToggle="HandleToggle" />
                }
            </div>
        }

        <!-- Live readings table -->
        @if (Opc.LastReadings.Any())
        {
            <div class="content-header" style="margin-top:2rem;">
                <h2>Live Readings</h2>
                <span class="badge">@Opc.LastReadings.Count rows</span>
            </div>

            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Display Name</th>
                            <th>Node ID</th>
                            <th>Value</th>
                            <th>Data Type</th>
                            <th>Quality</th>
                            <th>Timestamp</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Opc.LastReadings)
                        {
                            <tr class="@(r.Error != null ? "row-error" : "")">
                                <td>@r.DisplayName</td>
                                <td class="mono">@r.NodeId</td>
                                <td class="mono">@(r.Error ?? r.Value?.ToString() ?? "–")</td>
                                <td>@r.DataType</td>
                                <td class="@QualityClass(r.Quality)">@r.Quality</td>
                                <td class="mono">@r.Timestamp</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </main>
</div>

@code {
    private string _exportFormat = "Csv";
    private string _exportPath   = string.Empty;

    private int SelectedCount  => Opc.GetSelectedNodeIds().Count;
    private int FlatTagCount   => FlatAll(Opc.TagTree).Count(t => t.NodeClass == "Variable");

    protected override void OnInitialized()
    {
        Opc.StateChanged += StateHasChanged;
    }

    private async Task Browse()        => await Opc.BrowseAsync();
    private async Task ReadSelected()  => await Opc.ReadSelectedAsync();

    private async Task Export()
    {
        if (string.IsNullOrWhiteSpace(_exportPath))
        {
            await JS.InvokeVoidAsync("alert", "Please enter an output file path.");
            return;
        }

        var fmt = Enum.Parse<ExportFormat>(_exportFormat);
        await Opc.ExportAsync(new ExportOptions { OutputPath = _exportPath, Format = fmt });
    }

    private async Task BrowseOutputPath()
    {
        // Use WinForms SaveFileDialog via JS interop shim defined in MainForm
        try
        {
            var path = await JS.InvokeAsync<string>("showSaveDialog",
                _exportFormat == "Csv" ? "CSV Files|*.csv" : "JSON Files|*.json");
            if (!string.IsNullOrEmpty(path))
            {
                _exportPath = path;
                StateHasChanged();
            }
        }
        catch
        {
            // JS interop not available in some preview modes – ignore
        }
    }

    private void HandleToggle(OpcTag tag)
    {
        Opc.ToggleTag(tag);
    }

    private static string QualityClass(string? q) =>
        q == null ? "" :
        q.Contains("Good", StringComparison.OrdinalIgnoreCase) ? "quality-good" :
        q.Contains("Bad",  StringComparison.OrdinalIgnoreCase) ? "quality-bad" :
        "quality-uncertain";

    private static IEnumerable<OpcTag> FlatAll(IEnumerable<OpcTag> tags)
    {
        foreach (var t in tags)
        {
            yield return t;
            foreach (var c in FlatAll(t.Children))
                yield return c;
        }
    }

    public void Dispose() => Opc.StateChanged -= StateHasChanged;
}
