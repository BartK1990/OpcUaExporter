    private OpcTag? _contextMenuTag;
    private double _contextMenuX;
    private double _contextMenuY;
    private bool _contextMenuOpen;

    private NodeDetails? _nodeDetails;
    private bool _nodeDetailsOpen;
    private bool _nodeDetailsLoading;

    private bool _writeDialogOpen;
    private string? _writeDialogNodeId;
    private string? _writeDialogDisplayName;
    private string? _writeDialogDataType;
    private string _writeDialogValue = string.Empty;
    private string? _writeDialogError;

    private readonly Dictionary<string, string> _writeInputByNodeId = new(StringComparer.OrdinalIgnoreCase);

    private void HandleContextMenu((OpcTag Tag, MouseEventArgs Args) e)
    {
        _contextMenuTag = e.Tag;
        _contextMenuX = e.Args.ClientX;
        _contextMenuY = e.Args.ClientY;
        _contextMenuOpen = true;
    }

    private void CloseContextMenu()
    {
        _contextMenuOpen = false;
        _contextMenuTag = null;
    }

    private async Task ShowNodeProperties()
    {
        var tag = _contextMenuTag;
        CloseContextMenu();
        if (tag is null)
            return;

        _nodeDetailsOpen = true;
        _nodeDetailsLoading = true;
        _nodeDetails = null;
        StateHasChanged();

        _nodeDetails = await Opc.GetNodeDetailsAsync(tag.NodeId);
        _nodeDetailsLoading = false;
        StateHasChanged();
    }

    private void CloseNodeDetails()
    {
        _nodeDetailsOpen = false;
        _nodeDetails = null;
    }

    private void ShowWriteDialog()
    {
        var tag = _contextMenuTag;
        CloseContextMenu();
        if (tag is null || !tag.IsSelectable)
            return;

        var reading = FindReading(tag.NodeId);
        _writeDialogNodeId = tag.NodeId;
        _writeDialogDisplayName = tag.DisplayName;
        _writeDialogDataType = reading?.DataType ?? tag.DataType;
        _writeDialogValue = reading?.Value?.ToString() ?? tag.Value?.ToString() ?? string.Empty;
        _writeDialogError = null;
        _writeDialogOpen = true;
    }

    private void CloseWriteDialog()
    {
        _writeDialogOpen = false;
        _writeDialogNodeId = null;
        _writeDialogError = null;
    }

    private async Task SubmitWriteDialog()
    {
        if (string.IsNullOrWhiteSpace(_writeDialogNodeId) || string.IsNullOrWhiteSpace(_writeDialogValue))
            return;

        var result = await Opc.WriteValueAsync(_writeDialogNodeId, _writeDialogValue);
        if (result?.Error is not null)
            _writeDialogError = result.Error;
        else
            CloseWriteDialog();
    }

    private async Task OnWriteDialogKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SubmitWriteDialog();
    }

    private string GetWriteInput(string nodeId)
        => _writeInputByNodeId.TryGetValue(nodeId, out var v) ? v : string.Empty;

    private async Task WriteInlineValue(string nodeId)
    {
        if (!_writeInputByNodeId.TryGetValue(nodeId, out var rawValue) || string.IsNullOrWhiteSpace(rawValue))
            return;

        await Opc.WriteValueAsync(nodeId, rawValue);
    }

    private void OnServiceStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private static string QualityClass(string? q) =>
        q == null ? "" :
        q.Contains("Good", StringComparison.OrdinalIgnoreCase) ? "quality-good" :
        q.Contains("Bad",  StringComparison.OrdinalIgnoreCase) ? "quality-bad" :
        "quality-uncertain";

    private static IEnumerable<OpcTag> FlatAll(IEnumerable<OpcTag> tags)
    {
        foreach (var t in tags)
        {
            yield return t;
            foreach (var c in FlatAll(t.Children))
                yield return c;
        }
    }

    public void Dispose()
    {
        Opc.StateChanged -= OnServiceStateChanged;
        Opc.TrendUpdate -= OnTrendUpdate;
        ThemeSvc.CompactSelectedRowsChanged -= OnServiceStateChanged;
    }
