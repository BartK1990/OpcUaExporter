@page "/"
@using OpcUaExporter.Models
@using OpcUaExporter.Services
@inject OpcUaService Opc
@inject IJSRuntime JS
@implements IDisposable

<div class="app-shell">

    <!-- ═══════════════════════ SIDEBAR ═══════════════════════ -->
    <aside class="sidebar">
        <div class="sidebar-header">
            <div class="logo">
                <img class="logo-icon" src="app.ico" />
                <span class="logo-text">OPC UA<br><small>Exporter</small></span>
            </div>
        </div>

        <section class="panel">
            <h3 class="panel-title">Navigation</h3>
            <nav class="nav-menu">
                <NavLink href="/" Match="NavLinkMatch.All" class="btn btn-ghost nav-link">Tag Browser</NavLink>
                <NavLink href="/connection-settings" class="btn btn-ghost nav-link">Connection Settings</NavLink>
                <NavLink href="/diagnostics" class="btn btn-ghost nav-link">Diagnostics</NavLink>
            </nav>
        </section>

        @if (Opc.PendingCertificates.Any())
        {
            <section class="panel">
                <h3 class="panel-title">Server Certificates</h3>
                <p class="selection-count">Untrusted certificates detected. Review and trust as needed.</p>

                @foreach (var cert in Opc.PendingCertificates)
                {
                    <div class="status-bar status-error" style="margin-bottom:8px;">
                        <div><strong>@cert.Subject</strong></div>
                        <div class="mono" style="font-size:12px;">Issuer: @cert.Issuer</div>
                        <div class="mono" style="font-size:12px;">Thumbprint: @cert.Thumbprint</div>
                        <div style="font-size:12px;">Valid: @cert.ValidFrom.ToLocalTime():yyyy-MM-dd - @cert.ValidTo.ToLocalTime():yyyy-MM-dd</div>
                        <div class="btn-row" style="margin-top:8px;">
                            <button class="btn btn-secondary" @onclick="() => TrustCertificate(cert.Thumbprint)" disabled="@Opc.IsBusy">Trust</button>
                            <button class="btn btn-ghost" @onclick="() => RejectCertificate(cert.Thumbprint)" disabled="@Opc.IsBusy">Reject</button>
                        </div>
                    </div>
                }
            </section>
        }

        <!-- Connection profile -->
        <section class="panel">
            <h3 class="panel-title">Server Connection</h3>

            <label class="field-label">Server Name</label>
            <input class="field-input" @bind="Opc.Profile.Name" placeholder="My PLC" />

            <label class="field-label">Endpoint URL</label>
            <input class="field-input" @bind="Opc.Profile.EndpointUrl"
                   placeholder="opc.tcp://192.168.1.10:4840" />

            <button class="btn btn-primary" @onclick="Browse" disabled="@Opc.IsBusy">
                @if (Opc.IsBusy)
                {
                    <span class="spinner"></span><span>Working…</span>
                }
                else
                {
                    <span>⟳ Browse Tags</span>
                }
            </button>

            @if (Opc.IsBrowsing)
            {
                <button class="btn btn-ghost" @onclick="CancelBrowse">
                    ✕ Cancel Browse
                </button>
            }

            <div class="btn-row">
                <button class="btn btn-ghost" @onclick="SaveServerProfile" disabled="@Opc.IsBusy">Save Profile</button>
                <button class="btn btn-ghost" @onclick="LoadServerProfile" disabled="@Opc.IsBusy">Load Profile</button>
            </div>
        </section>

        <!-- Selection actions -->
        @if (Opc.TagTree.Any())
        {
            <section class="panel">
                <h3 class="panel-title">Selection</h3>
                <div class="btn-row">
                    <button class="btn btn-ghost" @onclick="() => Opc.SelectAll(true)">All</button>
                    <button class="btn btn-ghost" @onclick="() => Opc.SelectAll(false)">None</button>
                </div>
                <p class="selection-count">@SelectedCount tag(s) selected</p>

                <button class="btn btn-secondary" @onclick="ReadSelected" disabled="@Opc.IsBusy">
                    ▶ Read Values
                </button>

                <button class="btn btn-secondary" @onclick="SubscribeSelected" disabled="@Opc.IsBusy">
                    🔔 Subscribe
                </button>

                @if (Opc.IsSubscribed)
                {
                    <button class="btn btn-ghost" @onclick="StopSubscription" disabled="@Opc.IsBusy">
                        ⏹ Stop Subscription
                    </button>
                }
            </section>

            <!-- Export -->
            <section class="panel">
                <h3 class="panel-title">Export</h3>

                <label class="field-label">Format</label>
                <select class="field-input" @bind="_exportFormat">
                    <option value="Csv">CSV (.csv)</option>
                    <option value="Json">JSON (.json)</option>
                </select>

                <label class="field-label">Output Path</label>
                <div class="path-row">
                    <input class="field-input" @bind="_exportPath" placeholder="C:\export\tags.csv" />
                    <button class="btn btn-ghost icon-btn" @onclick="BrowseOutputPath" title="Browse…">📂</button>
                </div>

                <button class="btn btn-accent" @onclick="Export" disabled="@(Opc.IsBusy || SelectedCount == 0)">
                    ↓ Export Selected
                </button>
            </section>
        }

        <!-- Status bar -->
        <div class="status-bar @(Opc.HasError ? "status-error" : "status-ok")">
            @Opc.StatusMessage
        </div>
    </aside>

    <!-- ═══════════════════════ MAIN CONTENT ═══════════════════════ -->
    <main class="content @(Opc.LastReadings.Any() ? "content-split" : "")">

        <section class="browser-panel">
            @if (!Opc.TagTree.Any() && !Opc.IsBusy)
            {
                <div class="empty-state">
                    <div class="empty-icon">⬡</div>
                    <h2>No Tags Loaded</h2>
                    <p>Enter your OPC UA server endpoint and click <strong>Browse Tags</strong>.</p>
                </div>
            }
            else
            {
                <div class="content-header">
                    <h2>Tag Browser</h2>
                    <span class="badge">@Opc.BrowsedVariableCount variable tags</span>
                </div>

                <!-- Tag tree -->
                <div class="tag-tree-container tag-tree-scroll">
                    @foreach (var tag in Opc.TagTree)
                    {
                        <TagNode Tag="tag"
                                 OnToggle="HandleToggle"
                                 OnSelectAllInFolder="HandleSelectAllInFolder"
                                 OnSelectNoneInFolder="HandleSelectNoneInFolder" />
                    }
                </div>
            }
        </section>

        <!-- Live readings table -->
        @if (Opc.LastReadings.Any())
        {
            <section class="live-panel">
                <div class="content-header">
                    <h2>Live Readings</h2>
                    <span class="badge">@Opc.LastReadings.Count rows</span>
                </div>

                <div class="table-wrapper live-table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Display Name</th>
                                <th>Node ID</th>
                                <th>Value</th>
                                <th>Data Type</th>
                                <th>Quality</th>
                                <th>Timestamp</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Opc.LastReadings)
                            {
                                <tr class="@(r.Error != null ? "row-error" : "")">
                                    <td>@r.DisplayName</td>
                                    <td class="mono">@r.NodeId</td>
                                    <td class="mono">@(r.Error ?? r.Value?.ToString() ?? "–")</td>
                                    <td>@r.DataType</td>
                                    <td class="@QualityClass(r.Quality)">@r.Quality</td>
                                    <td class="mono">@r.Timestamp</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }

    </main>
</div>

@code {
    private static bool _startupProfilePromptShown;

    private string _exportFormat = "Csv";
    private string _exportPath   = string.Empty;

    private int SelectedCount  => Opc.GetSelectedNodeIds().Count;
    private int FlatTagCount   => Opc.BrowsedVariableCount;

    protected override void OnInitialized()
    {
        Opc.StateChanged += OnServiceStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _startupProfilePromptShown)
            return;

        _startupProfilePromptShown = true;

        var lastProfilePath = Opc.GetExistingLastProfilePath();
        if (string.IsNullOrWhiteSpace(lastProfilePath))
            return;

        try
        {
            var shouldLoad = await JS.InvokeAsync<bool>("showConfirm", $"Load last saved server profile?\n{lastProfilePath}");
            if (shouldLoad)
            {
                await Opc.LoadProfileAsync(lastProfilePath);
                StateHasChanged();
            }
        }
        catch
        {
            // JS interop not available in some preview modes – ignore
        }
    }

    private async Task Browse()        => await Opc.BrowseAsync();
    private Task CancelBrowse()
    {
        Opc.CancelBrowse();
        return Task.CompletedTask;
    }
    private async Task ReadSelected()  => await Opc.ReadSelectedAsync();
    private async Task SubscribeSelected() => await Opc.SubscribeSelectedAsync();
    private async Task StopSubscription() => await Opc.StopSubscriptionAsync();

    private async Task TrustCertificate(string thumbprint)
        => await Opc.TrustCertificateAsync(thumbprint);

    private Task RejectCertificate(string thumbprint)
    {
        Opc.RejectCertificate(thumbprint);
        return Task.CompletedTask;
    }

    private async Task Export()
    {
        if (string.IsNullOrWhiteSpace(_exportPath))
        {
            await JS.InvokeVoidAsync("alert", "Please enter an output file path.");
            return;
        }

        var fmt = Enum.Parse<ExportFormat>(_exportFormat);
        await Opc.ExportAsync(new ExportOptions { OutputPath = _exportPath, Format = fmt });
    }

    private async Task BrowseOutputPath()
    {
        // Use WinForms SaveFileDialog via JS interop shim defined in MainForm
        try
        {
            var path = await JS.InvokeAsync<string>("showSaveDialog",
                _exportFormat == "Csv" ? "CSV Files|*.csv" : "JSON Files|*.json");
            if (!string.IsNullOrEmpty(path))
            {
                _exportPath = path;
                StateHasChanged();
            }
        }
        catch
        {
            // JS interop not available in some preview modes – ignore
        }
    }

    private async Task SaveServerProfile()
    {
        try
        {
            var path = await JS.InvokeAsync<string>("showSaveDialog", "Server Profile (*.json)|*.json|All Files (*.*)|*.*");
            if (string.IsNullOrWhiteSpace(path))
                return;

            await Opc.SaveProfileAsync(path);
        }
        catch
        {
            // JS interop not available in some preview modes – ignore
        }
    }

    private async Task LoadServerProfile()
    {
        try
        {
            var path = await JS.InvokeAsync<string>("showOpenDialog", "Server Profile (*.json)|*.json|All Files (*.*)|*.*");
            if (string.IsNullOrWhiteSpace(path))
                return;

            await Opc.LoadProfileAsync(path);
            StateHasChanged();
        }
        catch
        {
            // JS interop not available in some preview modes – ignore
        }
    }

    private void HandleToggle(OpcTag tag)
    {
        Opc.ToggleTag(tag);
    }

    private void HandleSelectAllInFolder(OpcTag tag)
    {
        Opc.SelectInFolder(tag, true);
    }

    private void HandleSelectNoneInFolder(OpcTag tag)
    {
        Opc.SelectInFolder(tag, false);
    }

    private void OnServiceStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private static string QualityClass(string? q) =>
        q == null ? "" :
        q.Contains("Good", StringComparison.OrdinalIgnoreCase) ? "quality-good" :
        q.Contains("Bad",  StringComparison.OrdinalIgnoreCase) ? "quality-bad" :
        "quality-uncertain";

    private static IEnumerable<OpcTag> FlatAll(IEnumerable<OpcTag> tags)
    {
        foreach (var t in tags)
        {
            yield return t;
            foreach (var c in FlatAll(t.Children))
                yield return c;
        }
    }

    public void Dispose()
    {
        Opc.StateChanged -= OnServiceStateChanged;
    }
}
