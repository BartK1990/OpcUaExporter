    private readonly HashSet<string> _nonNumericTrendTags = new(StringComparer.OrdinalIgnoreCase);
    private bool _addPointErrorLogged;

    private void OnTrendUpdate(TagReading reading)
    {
        if (!TryGetNumeric(reading.Value, out var numericValue))
        {
            if (_nonNumericTrendTags.Add(reading.NodeId))
            {
                var typeName = reading.Value?.GetType().Name ?? "null";
                Diagnostics.Add($"Trend chart: '{reading.NodeId}' value '{reading.Value}' ({typeName}) is not numeric — not plotted.");
                _ = InvokeAsync(StateHasChanged);
            }
            return;
        }

        if (_nonNumericTrendTags.Remove(reading.NodeId))
            _ = InvokeAsync(StateHasChanged);

        var nodeId = reading.NodeId;
        var timestampMs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();

        _ = InvokeAsync(async () =>
        {
            try
            {
                await JS.InvokeVoidAsync("trendChart.addPoint", nodeId, timestampMs, numericValue);
            }
            catch (Exception ex)
            {
                if (!_addPointErrorLogged)
                {
                    _addPointErrorLogged = true;
                    Diagnostics.Add($"Trend chart failed to plot a point: {ex.Message}");
                }
            }
        });
    }

    private static bool TryGetNumeric(object? value, out double result)
    {
        // Some OPC UA servers report scalar values wrapped as a 1-element array.
        if (value is Array { Length: 1 } singleElementArray)
            value = singleElementArray.GetValue(0);

        switch (value)
        {
            case double d: result = d; return true;
            case float f: result = f; return true;
            case decimal m: result = (double)m; return true;
            case bool b: result = b ? 1 : 0; return true;
            case IConvertible conv:
                try
                {
                    result = conv.ToDouble(System.Globalization.CultureInfo.InvariantCulture);
                    return true;
                }
                catch
                {
                    result = 0;
                    return false;
                }
            default:
                result = 0;
                return false;
        }
    }

