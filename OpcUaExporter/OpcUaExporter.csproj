<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>wwwroot/app.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OpcUaExporter</RootNamespace>
    <AssemblyName>OpcUaExporter</AssemblyName>
    <!-- Required so WPF builds alongside Razor without conflict -->
    <StartupObject>OpcUaExporter.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="wwwroot\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="8.0.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.*" />
    <PackageReference Include="CsvHelper" Version="33.*" />
    <PackageReference Include="Newtonsoft.Json" Version="13.*" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua" Version="1.5.*" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Client" Version="1.5.*" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Configuration" Version="1.5.*" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="wwwroot\app.ico" />

    <Content Update="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
