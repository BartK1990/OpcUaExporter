<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Small, self-contained OPC UA simulation server for developing and testing
    the exporter without real hardware: a "Simulation" folder of changing
    values plus writable tags of the common built-in types. Not shipped.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>OpcUaExporter.SimServer</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Server" Version="1.5.*" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Configuration" Version="1.5.*" />
  </ItemGroup>

</Project>
