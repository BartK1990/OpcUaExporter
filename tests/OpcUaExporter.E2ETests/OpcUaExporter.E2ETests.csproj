<Project Sdk="Microsoft.NET.Sdk">

  <!--
    End-to-end UI tests: start the OPC UA simulation server and the browser host
    (OpcUaExporter.Web) in-process, then drive the real Blazor UI in headless
    Chromium via Playwright. Covers everything except the WPF shell itself.

    Needs a Playwright Chromium build. Either point PLAYWRIGHT_BROWSERS_PATH at an
    existing install, or after building run once:
      pwsh tests/OpcUaExporter.E2ETests/bin/Debug/net8.0/playwright.ps1 install chromium
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>OpcUaExporter.E2ETests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="Microsoft.Playwright" Version="1.56.0" />
    <PackageReference Include="xunit" Version="2.9.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.*" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpcUaExporter.Web\OpcUaExporter.Web.csproj" />
    <ProjectReference Include="..\..\tools\OpcUaExporter.SimServer\OpcUaExporter.SimServer.csproj" />
  </ItemGroup>

</Project>
